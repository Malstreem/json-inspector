{
  "manifest_version": 3,
  "name": "JSON Inspector - Visual Graph & Tree Explorer",
  "version": "0.1.0",
  "description": "Interactive, high-performance canvas graph and tree visualizer for deeply nested JSON data with zero tracking.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open JSON Inspector",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["sidePanel"],
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "devtools_page": "devtools.html"
}
